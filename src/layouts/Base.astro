---
import '@fontsource/big-shoulders-display/600';
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/barlow/400';
import '@fontsource/barlow/500';
import '@fontsource/barlow/600';
import '../styles/global.css';
import site from '../content/site.json';
import contact from '../content/contact.json';
import logo from '../assets/logo.png';
import { Image } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: unknown[];
  noindex?: boolean;
}
const { title = site.title, description = site.description, ogImage, jsonLd = [], noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const withBase = (href: string) => (href.startsWith('/') ? `${base}${href}` : href);
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)}>}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml">
  <meta name="theme-color" content="#e7e3d9">
  <script is:inline>document.documentElement.className = "js";</script>
  {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
</head>
<body>
  <header class="site" id="hdr">
    <div class="in">
      <a class="wordmark" href={withBase('/#top')}>
        <Image class="mark" src={logo} alt="" width={44} height={44} densities={[1, 2, 3]} format="png" loading="eager" />
        <span><small>{site.subName}</small>{site.shortName}</span>
      </a>
      <nav class="top" id="nav" aria-label="Sekcje strony">
        <a href={withBase('/#szkolenia')}>Szkolenia</a>
        <a href={withBase('/#jak-uczymy')}>Jak uczymy</a>
        <a href={withBase('/#kto-uczy')}>Kto uczy</a>
        <a href={withBase('/#faq')}>Pytania</a>
        <a href={withBase('/#kontakt')}>Kontakt</a>
      </nav>
      <a class="hdr-phone" href={contact.phoneHref}>{contact.phone}</a>
      <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
    </div>
  </header>

  <slot />

  <div class="tileband" aria-hidden="true"></div>
  <footer class="site">
    <div class="in">
      <a class="wordmark" href={withBase('/#top')}>
        <Image class="mark" src={logo} alt="" width={44} height={44} densities={[1, 2, 3]} format="png" loading="lazy" />
        <span><small>{site.subName}</small>{site.shortName}</span>
      </a>
      <div>
        <div>{site.name} · {site.by}</div>
        <div>{site.footer.legal}</div>
        <div class="stamp">Aktualizacja: {site.updatedLabel}</div>
      </div>
      <nav aria-label="Stopka">
        {site.footer.links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
      </nav>
    </div>
  </footer>

  <script>
    const hdr = document.getElementById('hdr')!;
    const mb = document.getElementById('menuBtn')!;
    const nav = document.getElementById('nav')!;
    mb.addEventListener('click', () => {
      const open = hdr.classList.toggle('open');
      mb.setAttribute('aria-expanded', String(open));
      mb.textContent = open ? 'Zamknij' : 'Menu';
    });
    nav.addEventListener('click', () => {
      hdr.classList.remove('open');
      mb.setAttribute('aria-expanded', 'false');
      mb.textContent = 'Menu';
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
